{
  "name": "forma-studio",
  "version": "1.10.0",
  "description": "A local visual design studio with editable templates, motion and intent-aware AI tools.",
  "author": "Forma Studio",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5186 --strictPort",
    "test": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "local": "node scripts/start-local.mjs",
    "ai:start": "node scripts/start-ai.mjs",
    "ai:stop": "node scripts/stop-ai.mjs",
    "test:server": "node --test tests/designer.test.mjs tests/photos.test.mjs tests/refinements.test.mjs tests/frames.test.mjs tests/brand-reference.test.mjs tests/campaigns.test.mjs tests/design-style.test.mjs tests/creative-direction.test.mjs tests/brand-imports.test.mjs",
    "test:ai-live": "node scripts/test-designer-live.mjs",
    "desktop": "node scripts/start-desktop.cjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:package:mac": "node scripts/package-desktop.mjs --mac",
    "desktop:package:win": "node scripts/package-desktop.mjs --win",
    "test:desktop": "node --test tests/desktop-platform.test.cjs tests/desktop-updates.test.cjs tests/desktop-render.test.mjs tests/cloud-backup.test.cjs",
    "test:updates": "node --test tests/desktop-updates.test.cjs",
    "desktop:smoke": "node scripts/test-desktop.mjs",
    "test:ai-lifetime": "node --experimental-test-module-mocks --test tests/job-lifetime.test.mjs",
    "test:providers": "node --test tests/ai-runtime.test.mjs tests/provider-protocol.test.mjs tests/provider-auth.test.cjs",
    "test:whiteboard": "node --test tests/whiteboard.test.mjs && node scripts/check-whiteboard.mjs",
    "test:collaboration": "node --test tests/collaboration.test.mjs tests/collaboration-network.test.cjs && node scripts/check-collaboration.mjs"
  },
  "build": {
    "appId": "studio.forma.desktop",
    "productName": "Forma Studio",
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-*/**/*",
      "dist/vendor/lamejs/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "postgigg",
        "repo": "forma-studio",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico",
      "artifactName": "Forma-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "installerSidebar": "desktop/installer-sidebar.bmp",
      "uninstallerSidebar": "desktop/installer-sidebar.bmp",
      "installerHeader": "desktop/installer-header.bmp"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record voice clips for your Forma Studio designs."
      },
      "minimumSystemVersion": "12.0",
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "Forma-Studio-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@openai/codex": "0.162.1",
    "@supabase/supabase-js": "2.117.3",
    "electron-updater": "6.8.10",
    "fabric": "7.4.0",
    "gifenc": "^1.0.3",
    "idb-keyval": "6.3.0",
    "jspdf": "4.2.1",
    "lucide-react": "1.55.0",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "selfsigned": "5.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-mac": "npm:electron@43.8.0",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
